# Apache Security Hardening - JanatulAulia Studio
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Block hidden files, except the ACME challenge directory.
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
    RewriteRule (^|/)\.(?!well-known/) - [F,L]
</IfModule>

<FilesMatch "\.(sql|env|ini|log|sh|bak|json|md|dist)$">
    Require all denied
</FilesMatch>

<FilesMatch "^(env\.php|database\.php|auth_check\.php|\.gitignore)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
